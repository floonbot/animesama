# ============================================================
#  AnimeSama — configuration optionnelle
#  Copie ce fichier en « .env » et ajuste ce que tu veux.
#  Tout est FACULTATIF : sans .env, l'app utilise les valeurs par défaut ci-dessous.
# ============================================================

# Port du serveur local interne auquel l'app se connecte.
# Change-le seulement si 7843 est déjà utilisé sur ta machine.
PORT=7843

# ------------------------------------------------------------
#  Téléchargement
# ------------------------------------------------------------
# Nombre de tentatives par épisode avant d'abandonner (1 = un seul essai).
DL_MAX_RETRIES=1

# Secondes d'attente entre deux tentatives.
DL_RETRY_DELAY=3

# Pré-extraction de l'épisode suivant pendant le téléchargement en cours.
# 0 = désactivé (recommandé : plus sûr pour l'anti-ban, ne sollicite pas les hébergeurs en parallèle)
# 1 = activé (un peu plus rapide, mais augmente le risque de blocage d'IP)
DL_PREFETCH=0

# ------------------------------------------------------------
#  Navigateur d'extraction (Playwright)
# ------------------------------------------------------------
# Fenêtre du navigateur pendant l'extraction des vidéos :
#   true  = sans fenêtre (défaut) — l'interception essaie jusqu'à 4 lecteurs à la
#           fois, donc 4 fenêtres Chromium s'ouvraient pendant un téléchargement
#   false = fenêtres visibles, à l'identique d'avant
# Mesuré sur 17 lecteurs x 3 configurations : même taux de capture (7/17).
BROWSER_HEADLESS=true

# Canal Chromium. « chromium » = le vrai Chrome sans fenêtre (« new headless »),
# c'est-à-dire le MÊME binaire que le mode visible : le fingerprint ne change pas.
# Vide = chrome-headless-shell, un autre binaire, plus facile à détecter.
BROWSER_CHANNEL=chromium

# Délai maximum (millisecondes) pour charger une page lecteur avant d'abandonner.
BROWSER_PAGE_TIMEOUT_MS=30000

# ------------------------------------------------------------
#  Avancé (décommente pour utiliser)
# ------------------------------------------------------------
# Adresse du site source. Utile pour revenir en arrière si le domaine change.
# SITE_URL=https://anime-sama.to

# Mettre à 1 pour désactiver la mise à jour automatique de yt-dlp au démarrage.
# ANIMESAMA_NO_YTDLP_UPDATE=0
