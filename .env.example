# ============================================================
#  AnimeSama — configuration optionnelle
#  Copie ce fichier en « .env » et ajuste ce que tu veux.
#  Tout est FACULTATIF : sans .env, l'app utilise les valeurs par défaut ci-dessous.
# ============================================================

# Port du serveur local interne auquel l'app se connecte.
# Change-le seulement si 7843 est déjà utilisé sur ta machine.
PORT=7843

# ------------------------------------------------------------
#  Téléchargement
# ------------------------------------------------------------
# Nombre de tentatives par épisode avant d'abandonner (1 = un seul essai).
DL_MAX_RETRIES=1

# Secondes d'attente entre deux tentatives.
DL_RETRY_DELAY=3

# Pré-extraction de l'épisode suivant pendant le téléchargement en cours.
# 0 = désactivé (recommandé : plus sûr pour l'anti-ban, ne sollicite pas les hébergeurs en parallèle)
# 1 = activé (un peu plus rapide, mais augmente le risque de blocage d'IP)
DL_PREFETCH=0

# ------------------------------------------------------------
#  Navigateur d'extraction (Playwright)
# ------------------------------------------------------------
# Fenêtre du navigateur pendant l'extraction des vidéos :
#   true  = sans fenêtre (défaut) — l'interception essaie jusqu'à 4 lecteurs à la
#           fois, donc 4 fenêtres Chromium s'ouvraient pendant un téléchargement
#   false = fenêtres visibles, à l'identique d'avant
# Mesuré sur 17 lecteurs x 3 configurations : même taux de capture (7/17).
BROWSER_HEADLESS=true

# Canal Chromium. « chromium » = le vrai Chrome sans fenêtre (« new headless »),
# c'est-à-dire le MÊME binaire que le mode visible : le fingerprint ne change pas.
# Vide = chrome-headless-shell, un autre binaire, plus facile à détecter.
BROWSER_CHANNEL=chromium

# Délai maximum (millisecondes) pour charger une page lecteur avant d'abandonner.
BROWSER_PAGE_TIMEOUT_MS=30000

# ------------------------------------------------------------
#  Dossiers et journal
# ------------------------------------------------------------
# Dossiers de sortie par défaut (l'interface peut les changer : data/user_settings.json).
# DOWNLOADS_DIR=D:\Animes
# SCANS_DIR=D:\Scans

# Journal disque, actif par défaut dans data/logs/app.log. 0 le coupe, un chemin le déplace.
# ANIMESAMA_LOG_FILE=0

# Déplace tout le dossier data/ (réglages, session, caches, file d'attente).
# ANIMESAMA_DATA_DIR=D:\AnimeSama-data

# ------------------------------------------------------------
#  Avancé (décommente pour utiliser)
# ------------------------------------------------------------
# Adresse du site source. Utile pour revenir en arrière si le domaine change.
# SITE_DOMAIN se déduit de SITE_URL ; ne le pose que s'il diffère.
# SITE_URL=https://anime-sama.to
# SITE_DOMAIN=anime-sama.to

# Base des URL de jaquettes.
# COVERS_BASE=https://raw.githubusercontent.com/Anime-Sama/IMG/img/contenu

# User-Agent des requêtes HTTP (par défaut un Chrome Windows récent).
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ...

# Mettre à 1 pour désactiver la mise à jour automatique de yt-dlp au démarrage.
# Le paquet installé ne se met jamais à jour seul.
# ANIMESAMA_NO_YTDLP_UPDATE=0

# Abandon d'un lecteur qui bride, au profit du suivant (seulement s'il en reste un).
# Seuil = DL_DEBIT_FRACTION_REF x meilleur débit déjà obtenu de l'hôte, borné en Mo/s.
# DL_ABANDON_LENT=1
# DL_DEBIT_PLANCHER_MO_S=0.8
# DL_DEBIT_PLAFOND_MO_S=3.0
# DL_DEBIT_FRACTION_REF=0.25
# DL_DEBIT_DEMARRAGE_S=25
# DL_DEBIT_FENETRE_S=45
# DL_DEBIT_RESTE_MIN_S=600
# DL_DEBIT_MAX_ABANDONS=2

# Extraction dans une iframe sandboxée pendant l'interception (bloque le détournement
# de la page par une pub). Désactivée par défaut.
# DL_EXTRACT_IFRAME=1

# Hébergeurs (JSON) : délais minimums par domaine en secondes, domaines à confier
# d'abord à yt-dlp, domaines hors service à ignorer, domaines à réécrire.
# DOMAIN_DELAYS_JSON={"vidmoly.net": 6}
# YTDLP_EXTRA_DOMAINS=["exemple.com"]
# HOSTS_MORTS_EXTRA=["hebergeur-mort.com"]
# HOST_DOMAIN_REWRITES_JSON={"vidmoly.to": "vidmoly.net"}

# Vérification de la cohérence des saisons auprès d'AniList (1 par défaut).
# ANILIST_COHERENCE=0

# Client HTTP asynchrone (httpx) pour le site, au lieu de requests.
# HTTP_ASYNC=1

# DANGER : yt-dlp ne vérifie plus les certificats TLS. Diagnostic seulement.
# YTDLP_INSECURE=1

# Journal console sans couleurs.
# NO_COLOR=1
